rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Payment slips are private: the signed-in owner can upload and view only
    // files in their own folder. Admin SDK access bypasses these client rules.
    match /support-slips/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    
    // Community chat images: authenticated users may upload images into their
    // own message folder. Files must be images and under 5 MB.
    match /community-chat/{userId}/{messageId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
